@page "/experience"

@using Portfolio.UI.Models

<PageTitle>Code By Alex | Experience</PageTitle>
@if(!IsLoading){
    <div class="d-flex flex-column align-items-center">
        @foreach(var s in ExperienceSections){
            <SectionComponent Title=@s.Title Centered=@s.Centered>
                @{
                    var parameters = DetermineParameters(s.Title ?? string.Empty);
                }
                <DynamicComponent Type="@s.ComponentType" Parameters="@parameters" />
            
            </SectionComponent>
        }
    </div>
}