@page "/projects"
@using Models.Portfolio
@using Portfolio.UI.Primitives
@using Portfolio.UI.Models

<PageTitle>Code By Alex | Projects</PageTitle>
@if(!IsLoading){
    <div class="d-flex flex-column align-items-center">
        @if(projectFilters != null)
        {
            <FilterBar TItem="Project" 
                    FilterCollectionDimensional="@projectFilters"
                    OnFiltersChanged="@StateHasChanged" />
        }
        
        @foreach(var s in Sections){
            <SectionComponent Title=@s.Title Centered=@s.Centered>
                @{
                    var parameters = DetermineParameters(s.Title ?? string.Empty);
                }
                <DynamicComponent Type="@s.ComponentType" Parameters="@parameters" />
            </SectionComponent>
        }
    </div>
}